# ============================================================
# VARIABLES DE ENTORNO — Control de Inventario de Repuestos
# ============================================================
# Copia este archivo como .env.local (desarrollo) o configura
# estas variables directamente en Vercel (producción).
# ============================================================

# BASE DE DATOS POSTGRESQL (Neon u otro proveedor)
# Obtén esta URL desde neon.tech → tu proyecto → Connection string
DATABASE_URL="postgresql://usuario:contraseña@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# AUTENTICACIÓN (NextAuth)
# Genera una clave segura en: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="reemplaza-con-una-clave-aleatoria-de-32-caracteres"
AUTH_SECRET="reemplaza-con-la-misma-clave-que-nextauth-secret"

# URL DE LA APLICACIÓN
# En Vercel: déjalo vacío, se detecta automáticamente
# En desarrollo local: http://localhost:3000
NEXTAUTH_URL="https://tu-app.vercel.app"
